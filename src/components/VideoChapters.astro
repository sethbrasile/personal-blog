---
interface Props {
  chapters?: { time: string; label: string }[];
}
const { chapters = [] } = Astro.props;
---
{chapters.length > 0 && (
  <section aria-labelledby="chapters" class="mt-4 flex flex-col gap-4">
    <h2 id="chapters" class="m-0 font-display text-[28px] font-extrabold leading-[1.1] tracking-[-0.025em]">Chapters</h2>
    <ul class="m-0 flex list-none flex-col p-0">
      {chapters.map((c) => (
        <li class="flex gap-4 border-b border-rule py-2 last:border-b-0 dark:border-rule-dark">
          <span class="w-14 shrink-0 font-mono text-sm leading-[1.65] text-muted dark:text-muted-dark">{c.time}</span>
          <span>{c.label}</span>
        </li>
      ))}
    </ul>
  </section>
)}
