---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <main class="mx-auto flex w-full max-w-[1180px] flex-col gap-5 px-4 pb-[72px] pt-14 sm:px-8">
    <h1 class="m-0 font-display text-[40px] font-extrabold leading-none tracking-[-0.035em] [text-wrap:balance] sm:text-[60px]">Page not found</h1>
    <p class="m-0 text-[19px] leading-[1.5] text-secondary dark:text-secondary-dark">Try the <a href="/videos/" class="underline underline-offset-[3px]">videos</a> or <a href="/posts/" class="underline underline-offset-[3px]">posts</a>.</p>
  </main>
</BaseLayout>
