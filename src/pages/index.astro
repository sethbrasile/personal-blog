---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import VideoCard from '@/components/VideoCard.astro';
import { SITE } from '@/lib/site';
import { getListedPosts, getListedVideos, videoPath } from '@/lib/content';
import { formatDate } from '@/lib/format';

const [video, ...moreVideos] = await getListedVideos();
const posts = (await getListedPosts()).slice(0, 6);

const thumb = video && (video.data.thumbnail ?? `https://i.ytimg.com/vi/${video.data.youtubeId}/maxresdefault.jpg`);
const fallbackThumb = video && `https://i.ytimg.com/vi/${video.data.youtubeId}/hqdefault.jpg`;
const watchUrl = video && `https://www.youtube.com/watch?v=${video.data.youtubeId}`;
const products = video?.data.products ?? [];
const hasParts = !!video && (products.length > 0 || (video.data.mentioned?.length ?? 0) > 0);
const videoCount = video ? 1 + (video.data.extras?.length ?? 0) : 0;
const meta = video && [formatDate(video.data.date), videoCount > 1 ? `${videoCount} videos` : null].filter(Boolean).join(' · ');

const btnFill = 'inline-flex min-h-12 items-center bg-ink px-[22px] font-medium !text-ground dark:bg-ink-dark dark:!text-ground-dark';
const btnLine = 'inline-flex min-h-12 items-center border-2 border-ink px-[22px] font-medium !text-ink dark:border-ink-dark dark:!text-ink-dark';
---
<BaseLayout title={SITE.name} description={SITE.description} headerVariant="masthead">
  <main class="mx-auto flex w-full max-w-[1180px] flex-col gap-20 px-4 pb-[72px] pt-14 sm:px-8">
    {video && (
      <section aria-labelledby="latest-video" class="grid grid-cols-[repeat(auto-fit,minmax(min(520px,100%),1fr))] items-end gap-12">
        <div class="flex flex-col gap-5">
          <p id="latest-video" class="m-0 flex items-center gap-3 font-mono text-[13px] uppercase tracking-[0.1em] text-muted dark:text-muted-dark"><span aria-hidden="true" class="inline-block h-[3px] w-7 bg-accent"></span>Latest video</p>
          <h1 class="m-0 font-display text-[40px] font-extrabold leading-[0.98] tracking-[-0.035em] [text-wrap:balance] sm:text-[72px]">{video.data.title}</h1>
          <p class="m-0 max-w-[46ch] text-[19px] leading-[1.5] text-secondary dark:text-secondary-dark">{video.data.description}</p>
          <p class="m-0 font-mono text-sm text-muted dark:text-muted-dark">{meta}</p>
          <div class="mt-1 flex flex-wrap gap-3">
            <a href={watchUrl} class={btnFill}>Watch on YouTube<span class="sr-only">: {video.data.title}</span></a>
            <a href={videoPath(video)} class={btnLine}>{hasParts ? 'Show notes and parts' : 'Show notes'}</a>
          </div>
        </div>
        <a href={videoPath(video)} aria-label={`Play: ${video.data.title}`} class="relative block overflow-hidden bg-ink shadow-[12px_12px_0_var(--color-accent)] dark:bg-ink-dark">
          <img src={thumb} alt="" width="1280" height="720" onerror={`this.onerror=null;this.src='${fallbackThumb}'`} class="block aspect-video w-full object-cover" />
          <span aria-hidden="true" class="absolute bottom-6 left-6 flex h-16 w-16 items-center justify-center bg-ground dark:bg-ground-dark">
            <svg width="26" height="26" viewBox="0 0 24 24" class="fill-ink dark:fill-ink-dark"><path d="M8 5v14l11-7z" /></svg>
          </span>
        </a>
      </section>
    )}

    {moreVideos.length > 0 && (
      <section id="videos" aria-labelledby="more-videos" class="flex flex-col">
        <div class="flex items-baseline justify-between gap-4 border-b-2 border-ink pb-[10px] dark:border-ink-dark">
          <h2 id="more-videos" class="m-0 font-display text-[34px] font-extrabold tracking-[-0.02em]">Videos</h2>
        </div>
        <ul class="m-0 mt-6 grid list-none grid-cols-[repeat(auto-fill,minmax(min(340px,100%),1fr))] gap-x-10 gap-y-10 p-0">
          {moreVideos.slice(0, 3).map((entry) => <VideoCard entry={entry} />)}
        </ul>
      </section>
    )}

    <section id="posts" aria-labelledby="latest-posts" class="flex flex-col">
      <div class="flex items-baseline justify-between gap-4 border-b-2 border-ink pb-[10px] dark:border-ink-dark">
        <h2 id="latest-posts" class="m-0 font-display text-[34px] font-extrabold tracking-[-0.02em]">Latest posts</h2>
        <a href="/posts/" class="font-medium">All posts</a>
      </div>
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] gap-x-10 gap-y-0 p-0">
        {posts.map((entry, i) => <PostCard entry={entry} number={i + 1} />)}
      </ol>
    </section>

    <section aria-labelledby="store-heading" class="on-accent grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] items-center gap-8 bg-accent p-6 text-[#172f3e] sm:p-12">
      <div class="flex flex-col gap-[14px]">
        <p class="m-0 font-mono text-[13px] uppercase tracking-[0.1em]">Store</p>
        <h2 id="store-heading" class="m-0 font-display text-[32px] font-extrabold leading-none tracking-[-0.03em] sm:text-[40px]">Kits, cases and sensors from the videos</h2>
        <a href={SITE.store} class="mt-2 inline-flex min-h-12 items-center self-start bg-[#172f3e] px-[22px] font-medium !text-[#f2f4f5]">Visit the store</a>
      </div>
      {products.length > 0 && (
        <ul class="m-0 flex list-none flex-col p-0">
          {products.map((p) => (
            <li class="border-b border-[#172f3e] py-[14px] last:border-b-0">
              <a href={p.url} class="font-medium !text-[#172f3e]">{p.label}</a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</BaseLayout>
