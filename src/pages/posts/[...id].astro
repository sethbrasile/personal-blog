---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import TagList from '@/components/TagList.astro';
import { getListedPosts, getPublishedPosts, postPath } from '@/lib/content';
import { formatDate } from '@/lib/format';
import { seriesNeighbours } from '@/lib/series';

export async function getStaticPaths() {
  return (await getPublishedPosts()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, author, cover, tags, note, unlisted, date } = entry.data;

const ogImage = cover ? new URL((await getImage({ src: cover.image, width: 1200 })).src, Astro.site).href : undefined;
const { prev, next } = seriesNeighbours(await getPublishedPosts(), entry);
const more = (await getListedPosts()).filter((p) => p.id !== entry.id).slice(0, 2);

const toc = headings.filter((h) => h.depth <= 3);
const topDepth = Math.min(...toc.map((h) => h.depth));
const arrow = 'text-sm text-muted dark:text-muted-dark';
---
<BaseLayout title={title} description={description} noindex={unlisted} ogType="article" ogImage={ogImage}>
  <main class="mx-auto flex w-full max-w-[1180px] flex-col gap-16 px-4 pb-[72px] pt-14 sm:px-8">
    <article class="grid grid-cols-1 items-start gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,760px)_320px] lg:justify-between text-[18px] leading-[1.65]">
      <div class="flex min-w-0 max-w-[760px] flex-col gap-10">
        <div class="flex flex-col gap-5">
          <p class="m-0 flex items-center gap-3 font-mono text-[13px] uppercase tracking-[0.1em] text-muted dark:text-muted-dark"><span aria-hidden="true" class="inline-block h-[3px] w-7 shrink-0 bg-accent"></span>Post · {formatDate(date)} · {author}</p>
          <h1 class="m-0 font-display text-[40px] font-extrabold leading-none tracking-[-0.035em] [text-wrap:balance] sm:text-[60px]">{title}</h1>
          <TagList tags={tags} />
        </div>

        {cover && <Image src={cover.image} alt={cover.alt} widths={[480, 760, 1520]} sizes="(min-width: 840px) 760px, 100vw" class="block h-auto w-full" />}

        {note && (
          <div class="flex flex-col gap-5 border-b border-rule pb-5 dark:border-rule-dark">
            <p class="m-0 italic text-secondary dark:text-secondary-dark">Note: {note}</p>
          </div>
        )}

        <div class="prose dark:prose-invert post-body"><Content /></div>

        {(prev || next) && (
          <nav aria-label="Series" class="flex flex-wrap justify-between gap-x-8 gap-y-4 border-t-2 border-ink pt-4 dark:border-ink-dark">
            {prev ? <a href={postPath(prev)} class="flex flex-col gap-1"><span class={arrow}>Part {prev.data.series?.part}</span><span class="font-display text-[20px] font-medium leading-[1.2]">{prev.data.title}</span></a> : <span />}
            {next && <a href={postPath(next)} class="flex flex-col gap-1 text-right"><span class={arrow}>Part {next.data.series?.part}</span><span class="font-display text-[20px] font-medium leading-[1.2]">{next.data.title}</span></a>}
          </nav>
        )}
      </div>

      {toc.length > 0 && (
        <aside aria-label="On this page" class="flex max-w-[320px] flex-col gap-3 border-t-2 border-ink pt-[14px] dark:border-ink-dark">
          <p class="m-0 font-mono text-[13px] uppercase tracking-[0.1em] text-muted dark:text-muted-dark">On this page</p>
          <nav aria-label="Table of contents" class="flex flex-col gap-2 text-[15px] leading-[1.4]">
            {toc.map((h) =>
              h.depth === topDepth ? (
                <a href={`#${h.slug}`} class="font-medium !text-ink dark:!text-ink-dark">{h.text}</a>
              ) : (
                <a href={`#${h.slug}`} class="pl-[14px] !text-muted dark:!text-muted-dark">{h.text}</a>
              ),
            )}
          </nav>
        </aside>
      )}
    </article>

    {more.length > 0 && (
      <section aria-labelledby="more-posts" class="flex flex-col">
        <div class="flex items-baseline justify-between gap-4 border-b-2 border-ink pb-[10px] dark:border-ink-dark">
          <h2 id="more-posts" class="m-0 font-display text-[30px] font-extrabold tracking-[-0.02em]">More posts</h2>
          <a href="/posts/" class="font-medium">All posts</a>
        </div>
        <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] gap-x-10 gap-y-0 p-0">
          {more.map((p) => <PostCard entry={p} compact showTags={false} />)}
        </ol>
      </section>
    )}
  </main>
</BaseLayout>
