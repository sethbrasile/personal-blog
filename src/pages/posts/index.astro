---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getListedPosts } from '@/lib/content';

const posts = await getListedPosts();
---
<BaseLayout title="Posts">
  <main class="mx-auto w-full max-w-[1180px] px-4 pb-[72px] pt-14 sm:px-8">
    <div class="border-b-2 border-ink pb-[10px] dark:border-ink-dark">
      <h1 class="m-0 font-display text-[40px] font-extrabold leading-none tracking-[-0.035em] sm:text-[60px]">Posts</h1>
    </div>
    <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] gap-x-10 gap-y-0 p-0">
      {posts.map((entry, i) => <PostCard entry={entry} number={i + 1} showDescription />)}
    </ol>
  </main>
</BaseLayout>
