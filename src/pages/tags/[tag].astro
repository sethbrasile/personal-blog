---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import VideoCard from '@/components/VideoCard.astro';
import { getTagIndex } from '@/lib/content';

export async function getStaticPaths() {
  const index = await getTagIndex();
  return [...index].map(([slug, bucket]) => ({ params: { tag: slug }, props: { bucket } }));
}
const { bucket } = Astro.props;
const both = bucket.posts.length > 0 && bucket.videos.length > 0;
---

<BaseLayout title={bucket.name} noindex="follow">
  <main class="mx-auto flex w-full max-w-[1180px] flex-col gap-10 px-4 pb-[72px] pt-14 sm:px-8">
    <div class="flex flex-col gap-5">
      <p class="m-0 flex items-center gap-3 font-mono text-[13px] uppercase tracking-[0.1em] text-muted dark:text-muted-dark">
        <span aria-hidden="true" class="inline-block h-[3px] w-7 shrink-0 bg-accent"></span>Tag
      </p>
      <h1 class="m-0 font-display text-[40px] font-extrabold leading-none tracking-[-0.035em] [text-wrap:balance] sm:text-[60px]">
        {bucket.name}
      </h1>
    </div>
    {both && <h2 class="m-0 font-display text-[30px] font-extrabold tracking-[-0.02em]">Posts</h2>}
    {bucket.posts.length > 0 && (
      <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] gap-x-10 gap-y-0 p-0">
        {bucket.posts.map((entry, i) => (
          <PostCard entry={entry} number={i + 1} showDescription />
        ))}
      </ol>
    )}
    {both && <h2 class="m-0 font-display text-[30px] font-extrabold tracking-[-0.02em]">Videos</h2>}
    {bucket.videos.length > 0 && (
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(340px,100%),1fr))] gap-x-10 gap-y-12 p-0">
        {bucket.videos.map((entry) => (
          <VideoCard entry={entry} />
        ))}
      </ul>
    )}
  </main>
</BaseLayout>
